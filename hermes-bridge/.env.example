# Copy this file to .env and fill in real values:  cp .env.example .env
# Never commit .env to git.

# ---------------- Hermes (OpenAI-compatible API) ----------------
# Local Hermes; change to a remote URL later if needed (keep the /v1 suffix).
HERMES_BASE_URL=http://localhost:8642/v1
HERMES_API_KEY=your-hermes-api-key
HERMES_MODEL=hermes-agent
# Seconds to wait for Hermes before giving up and sending FALLBACK_MESSAGE.
# Keep this below AutoResponder's own request timeout.
HERMES_TIMEOUT=60
# Extra attempts on connection errors / 5xx (0 = no retry).
HERMES_MAX_RETRIES=1
SYSTEM_PROMPT=You are a helpful assistant replying to chat messages. Keep replies short, friendly, and conversational.

# ---------------- Security ----------------
# Basic Auth credentials (enter the same values in AutoResponder). REQUIRED.
# Generate a strong password:  python -c "import secrets; print(secrets.token_urlsafe(24))"
BASIC_AUTH_USERNAME=autoresponder
BASIC_AUTH_PASSWORD=change-me-to-a-long-random-string

# Optional second layer. Leave AUTH_HEADER_TOKEN empty to disable.
# If set, AutoResponder must send header  X-Auth-Token: <this value>
AUTH_HEADER_NAME=X-Auth-Token
AUTH_HEADER_TOKEN=change-me-to-another-long-random-string

# ---------------- Behaviour ----------------
FALLBACK_MESSAGE=Sorry, I'm having trouble right now.
MAX_INPUT_CHARS=4000
MAX_REPLY_CHARS=2000
# Previous exchanges remembered per chat (0 = no memory). Memory is in RAM
# and resets when the server restarts.
HISTORY_TURNS=5
HISTORY_MAX_CHATS=500

# ---------------- Server ----------------
# 127.0.0.1 = only reachable through the tunnel (recommended).
# 0.0.0.0   = also reachable from other devices on your Wi-Fi/LAN.
HOST=127.0.0.1
PORT=5000
# Log file path (leave empty to log to stdout only).
LOG_FILE=bridge.log
LOG_LEVEL=INFO

# ---------------- ngrok (only if you use run_ngrok.py) ----------------
NGROK_AUTHTOKEN=
# Optional free static domain from the ngrok dashboard, e.g. my-name.ngrok-free.app
NGROK_DOMAIN=
